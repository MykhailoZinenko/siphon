# data: 33 GB of power traces and their caches - never in git
siphon/data/
*.npy

# python env and caches
venv/
__pycache__/
*.pyc
.DS_Store
.vscode/
.codeiumignore

# per-run outputs (regenerated on every run)
siphon/runs/

# firmware build artifacts (regenerated by the toolchain)
siphon/firmware/source/*.hex
siphon/firmware/source/*.elf
siphon/firmware/source/*.map
siphon/firmware/source/*.lss
siphon/firmware/source/*.sym
siphon/firmware/source/*.eep
siphon/firmware/source/objdir/
siphon/firmware/source/*.o

# assistant instruction file - not part of the thesis
CLAUDE.md

# local tooling config and supervisor drafts - not for the public repo
.claude/
figures/email_draft.md
figures/teams_message.md

# third-party reference binary (previous student) - kept local, not published
siphon/firmware/reference-student.hex
# editor swap files
*.swp

# internal agent/handoff docs - not part of the thesis
AGENTS.md
HANDOFF.md
# python build metadata
*.egg-info/
